<odoo>

    <template id="mulata_product_page" name="Mulata Product V1" inherit_id="website_sale.product">

        <!-- ==================================================
             ESTRUCTURA VISUAL
             ================================================== -->

        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="t-attf-class" add="mulata-product-page" separator=" "/>
        </xpath>

        <xpath expr="//div[@id='product_details']" position="attributes">
            <attribute name="t-attf-class" add="mulata-product-info" separator=" "/>
        </xpath>

        <!-- Información comercial debajo del precio -->
        <xpath expr="//div[contains(@class, 'o_wsale_product_details_content_section_price')]" position="after">

            <div class="mulata-commerce-extras">

                <div class="mulata-installments">
                    <i class="fa fa-credit-card"/>
                    <span>
                        Hasta <strong>12 cuotas</strong>
                    </span>
                </div>

                <div class="mulata-transfer">
                    <i class="fa fa-money"/>
                    <div>
                        <small>Precio especial</small>
                        <strong>Consultá descuento por transferencia</strong>
                    </div>
                </div>

                <div class="mulata-logistics">

                    <div class="mulata-logistics-item">
                        <i class="fa fa-truck"/>
                        <span>
                            <strong t-if="product.mulata_is_gelbring">Entrega desde proveedor</strong><strong t-else="">Entrega coordinada</strong>
                            <small t-if="product.mulata_is_gelbring">Plazo sujeto a confirmación</small><small t-else="">Plazo según producto y destino</small>
                        </span>
                    </div>

                    <div class="mulata-logistics-item">
                        <i class="fa fa-cube"/>
                        <span>
                            <strong>Todo el país</strong>
                            <small t-if="product.mulata_is_gelbring">Condiciones según destino</small><small t-else="">Consultá opciones de envío</small>
                        </span>
                    </div>

                    <div class="mulata-logistics-item">
                        <i class="fa fa-shield"/>
                        <span>
                            <strong>Envío Protegido</strong>
                            <small>Compra segura</small>
                        </span>
                    </div>

                </div>

                <div class="mulata-stock">
                    <span class="mulata-stock-dot"/>
                    <span t-if="product.mulata_is_gelbring">Disponibilidad a confirmar</span><span t-else="">Consultá disponibilidad</span>
                </div>

            </div>

        </xpath>


        <!-- Beneficios secundarios -->
        <xpath expr="//div[@id='o_wsale_product_details_content']" position="inside">

            <div class="mulata-benefits">

                <div>
                    <i class="fa fa-check-circle"/>
                    <span>
                        <strong>Compra segura</strong>
                        <small>Protegemos tu compra durante todo el proceso</small>
                    </span>
                </div>

                <div>
                    <i class="fa fa-map-marker"/>
                    <span>
                        <strong>Retiro o envío</strong>
                        <small>Elegí la opción que más te convenga</small>
                    </span>
                </div>

                <div>
                    <i class="fa fa-whatsapp"/>
                    <span>
                        <strong>¿Tenés dudas?</strong>
                        <small>Te ayudamos por WhatsApp</small>
                    </span>
                </div>

            </div>

        </xpath>



        <!-- Barra de compra móvil -->
        <xpath expr="//section[@id='product_detail']" position="after">

            <div class="mulata-mobile-buybar">

                <div class="mulata-mobile-price">
                    <small>Precio</small>
                    <strong>
                        <t t-call="website_sale.product_price"/>
                    </strong>
                </div>

                <button type="button" class="mulata-mobile-add" onclick="var b=document.querySelector('#product_detail #add_to_cart'); if(b){b.click();}">

                    <i class="fa fa-shopping-cart me-2"/>
                    Agregar al carrito

                </button>

            <button type="button" class="mulata-mobile-compare" t-if="product._can_be_added_to_comparison()" aria-label="Agregar a comparación" title="Comparar" onclick="var b=document.querySelector('#product_detail .o_add_compare_dyn');if(b){b.click();}"><i class="fa fa-exchange" aria-hidden="true"/><span>Comparar</span></button></div>

        </xpath>

    </template>





<!-- =========================================================
     MULATA — GALERÍA PRODUCTO
     Carrusel manual, sin autoplay
     ========================================================= -->


    <!-- MULATA DATOS MONEDA FICHA -->
    <template id="mulata_product_currency_data"
              inherit_id="website_sale.product"
              priority="70">

        <xpath expr="//section[@id='product_detail']"
               position="attributes">

            <attribute name="t-att-data-mulata-currency">
                product.mulata_display_currency
            </attribute>

            <attribute name="t-att-data-mulata-rate">
                product.mulata_exchange_rate or 42.0
            </attribute>

        </xpath>

    </template>

</odoo>