<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_home_featured_form" model="ir.ui.view">
        <field name="name">product.template.home.featured.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <group string="Home Mulata"
                       name="mulata_home_settings">

                    <group>
                        <field name="is_home_featured"/>
                        <field name="home_featured_sequence"
                               invisible="not is_home_featured"/>
                    </group>

                </group>

            </xpath>

        </field>
    </record>

</odoo>
